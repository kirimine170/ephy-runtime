{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ephy.local/schemas/memory_object.schema.json",
  "title": "Ephy Memory Object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "memory_id",
    "instance_id",
    "subject",
    "type",
    "content",
    "source",
    "confidence",
    "created_at",
    "updated_at",
    "valid_from",
    "valid_until",
    "retention_policy",
    "consent",
    "status",
    "supersedes"
  ],
  "properties": {
    "memory_id": {
      "type": "string",
      "format": "uuid"
    },
    "instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "fact",
        "preference",
        "relationship",
        "project",
        "event",
        "interpretation",
        "instruction",
        "temporary_state"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "reference"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "conversation",
            "user_input",
            "import",
            "tool",
            "system"
          ]
        },
        "reference": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_until": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "retention_policy": {
      "type": "string",
      "enum": [
        "session",
        "until_expiry",
        "until_deleted"
      ]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_allowed",
        "training_allowed"
      ],
      "properties": {
        "storage_allowed": {
          "type": "boolean"
        },
        "training_allowed": {
          "type": "boolean"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "deleted",
        "expired"
      ]
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
